{
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
